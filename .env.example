# harness-lab 环境变量模板
# 用法：cp .env.example .env，然后把下面的占位符换成真实值。
# .env 里放密钥，不要提交；仓库里只保留这个模板。

# ---------- LLM（OpenAI 兼容格式，经 LiteLLM 调用） ----------
# API Key：官方 OpenAI 或任意 OpenAI 兼容服务商的 Key
OPENAI_API_KEY=sk-replace-me

# 接口地址：必须带 /v1。用官方 OpenAI 时可以不设（删掉或注释这一行）；
# 用第三方兼容服务时填它的地址，例如 https://your-provider.example.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# 模型名：LiteLLM 的 "openai/" 前缀表示"按 OpenAI 协议调用"，后半部分是服务商那边的模型 ID。
# 主模型：跑 agent 主循环
MODEL_MAIN=openai/your-main-model-id
# 摘要模型：给 summarize / hybrid 上下文策略生成摘要，选便宜的
MODEL_CHEAP=openai/your-cheap-model-id

# ---------- 预算（CLAUDE.md §2.5） ----------
# 累计花费上限（美元）。超过 80% 就停下来确认；启动超过 10 个任务的批量运行前先打印预估花费。
# 20 只是占位值，不是估算：等 dev_5 实测出单题成本后，按 plan.md 的预算表重新填。
MAX_TOTAL_COST_USD=20

# ---------- 可选：OpenTelemetry 导出（src/harness/tracing/otel.py） ----------
# 设为 1 才导出；JSONL 轨迹不受影响，仍是报告数字的唯一来源。
# HARNESS_OTEL=1
# Langfuse Cloud（EU；US 用 https://us.cloud.langfuse.com/api/public/otel）。
# AUTH 是 base64("pk-lf-...:sk-lf-...")，例如：echo -n "pk-lf-...:sk-lf-..." | base64 -w 0
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <AUTH>,x-langfuse-ingestion-version=4
# 任何 OTLP/HTTP 接收端都可以，例如本地 Jaeger：http://127.0.0.1:4318
